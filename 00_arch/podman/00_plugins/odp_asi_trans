# reconciliationGroupId and expected record count, filters the .par file
# in-place, and hard-fails if the count does not match.
# Splitter will NOT run if this step exits non-zero.
#
# Placeholders — must match values in kafka_trigger_status_messages.py config:
#   statusmessages_feed_name  -> STATUSMESSAGES_FEED_NAME (e.g. CPSB4Q00)
#   metadata_suffix           -> METADATA_FILE_SUFFIX     (e.g. _metadata.txt)

statusmessages_feed_name="CPSB4Q00"
metadata_suffix="_metadata.txt"
skip_count_check=""           # set to "--skip-count-check" to disable count validation

$DWP_ROOT/feeds/$stream/$feed_name/bin/filter_recon_group.py \
    --log-file         $log_filename \
    --kafka-data       $1 \
    --status-feed-name $statusmessages_feed_name \
    --asof-date        ${B4Q_ASOF_DT} \
    --metadata-suffix  $metadata_suffix \
    --separator        "|" \
    ${skip_count_check}

rc=$?
if [[ $rc -ne 0 ]]; then
    echo "Error: Reconciliation group filter failed (rc=$rc). Splitter will not run."
    exit 1
fi
echo "Reconciliation group filter completed successfully."



splitter_start_time=$(date +%s)

$DWP_ROOT/feeds/$stream/$feed_name/bin/splitter.py \
