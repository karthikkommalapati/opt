extract_string=$(echo "$2" | awk -v pattern="$pattern" 'tolower($0) ~ tolower(pattern) {print substr($0, index(tolower($0), tolower(pattern)) + length(pattern))}')


splitter_filename="splitter_final${extract_string}_${mandate}_${instance_name}.csv"
